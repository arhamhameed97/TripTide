# Google Gemini API Key
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Amadeus API (for flights)
# Get your credentials from: https://developers.amadeus.com/
AMADEUS_CLIENT_ID=your_amadeus_client_id_here
AMADEUS_CLIENT_SECRET=your_amadeus_client_secret_here

# RapidAPI Key (for hotels via Booking.com)
# Get your key from: https://rapidapi.com/apidojo/api/booking-com/
RAPIDAPI_KEY=your_rapidapi_key_here

# OpenWeatherMap API Key (for weather forecasts)
# Get your key from: https://openweathermap.org/api
# Note: Free tier allows 1000 calls per day
OPENWEATHER_API_KEY=your_openweather_api_key_here

# NewsAPI Key (for local news)
# Get your key from: https://newsapi.org/
NEWS_API_KEY=your_news_api_key_here

# Note: Copy this file to .env.local and fill in your actual API keys
# The app will work with fallback data even without these keys
